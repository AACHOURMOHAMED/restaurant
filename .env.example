# ─────────────────────────────────────────────────────────────────────────────
#  B&B Park website — server configuration
#  Copy to `.env` and fill in. `npm start` and `docker compose` read it.
#  Every variable is optional; the defaults are shown.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the website, e.g. https://www.bandbpark.ma (no trailing
# slash). Used in the table QR codes, links and search-engine tags.
# Set it BEFORE printing the QR codes.
PUBLIC_URL=

# Where the database, uploaded dish photos and backups are stored.
# Back this folder up. (In Docker it is the `restaurant-data` volume.)
DATA_DIR=./data

# Optional: a PostgreSQL server instead of the embedded database in DATA_DIR
# (on Vercel it is required, and set for you when a Neon database is connected).
# DATABASE_URL=postgres://user:password@host:5432/bbpark

# Optional: store dish photos in Vercel Blob instead of DATA_DIR/uploads
# (on Vercel, set for you when a Blob store is connected).
# BLOB_READ_WRITE_TOKEN=

HOST=0.0.0.0
PORT=3000

# First administrator, created automatically on start-up when no staff account
# exists yet. You can remove these two lines once the account exists, or create
# accounts with `npm run create-admin` instead. Password: 10 characters or more.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrateur

# Behind a reverse proxy (nginx, Caddy…): the NUMBER of proxies in front of the
# app (1, or 2 with Cloudflare in front too), so rate limiting sees real visitor
# IPs. Not `true` — that would let visitors fake their address.
# TRUST_PROXY=1

# Staff session cookie: `auto` = HTTPS-only in production (requires HTTPS).
# `npm start` and Docker run in production mode.
# COOKIE_SECURE=auto
# SESSION_TTL_HOURS=168

# Optional: POST a JSON notification to this URL for every new reservation,
# guest cancellation, status change and new table order (no personal data is
# sent — see README "Notifications"). Works with Make, Zapier, n8n, a Slack or
# Discord incoming webhook relay, etc.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/bbpark

# Erase the name, phone, email and notes of reservations older than N days
# (0 = keep forever). 180 is a sensible choice.
RETENTION_DAYS=0

# Protects the public forms against abuse. Leave on in production.
# RATE_LIMIT=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
